# Generating Prediction Files
cd <path_to_submission_folder>  
python3 predict.py \
    --data <path_to_dataset> \
    --model <path_to_pt_file> \
    --output <path_to_output_file>

## Example 1: Generate prediction using blstm1 model on dev data (Task 1)
cd /Users/paul/Desktop/cs544/hw3/submission  
python3 predict.py \
    --data /Users/paul/Desktop/cs544/hw3/data/dev \
    --model blstm1.pt \
    --output dev1.out

## Example 2: Generate prediction using blstm2 model on dev data (Task 2)
cd /Users/paul/Desktop/cs544/hw3/submission  
python3 predict.py \
    --data /Users/paul/Desktop/cs544/hw3/data/dev \
    --model blstm2.pt \
    --output dev2.out

## Example 3: Generate prediction using blstm1 model on test data (Task 1)
cd /Users/paul/Desktop/cs544/hw3/submission  
python3 predict.py \
    --data /Users/paul/Desktop/cs544/hw3/data/test \
    --model blstm1.pt \
    --output test1.out

## Example 4: Generate prediction using blstm2 model on test data (Task 2)
cd /Users/paul/Desktop/cs544/hw3/submission  
python3 predict.py \
    --data /Users/paul/Desktop/cs544/hw3/data/test \
